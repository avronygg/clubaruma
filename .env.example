# Endpoint que recibe los correos de la lista de espera (POST JSON {email, source}).
# Sirve cualquier servicio: Formspree, Brevo, Mailchimp o una función propia.
# Mientras esté vacío, el formulario lo indica en pantalla en vez de simular un alta.
VITE_WAITLIST_ENDPOINT=""

# Bloquea la indexación del sitio entero. Ponlo a 1 mientras la web esté en un
# dominio de vista previa y quítalo al pasar al dominio definitivo.
VITE_NOINDEX=1
